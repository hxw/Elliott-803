MULTIPLICATION TABLES'
BEGIN

  INTEGER C, R'
  INTEGER ROWS, COLUMNS'

  ROWS := 13'
  COLUMNS := 13'

  PUNCH(3)'

  PRINT ££L?MULTIPLICATION TABLES£L?    ?'

  FOR C := 1 STEP 1 UNTIL COLUMNS DO
  BEGIN
    PRINT SAMELINE, DIGITS(3), C'
  END'

  FOR R := 1 STEP 1 UNTIL ROWS DO
  BEGIN

    PRINT SAMELINE, ££L??, DIGITS(3), R'

    FOR C := 1 STEP 1 UNTIL COLUMNS DO
    BEGIN
      PRINT SAMELINE, DIGITS(3), R*C'
    END'
  END'

END'
